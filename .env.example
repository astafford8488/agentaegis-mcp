# AgentAegis MCP Server Configuration

# Server
PORT=3000
NODE_ENV=development

# Skip payment verification (dev only — never set in production)
SKIP_PAYMENT=false

# Force payment requirement on stdio transport (default: false, allows local Claude Desktop usage without payment)
REQUIRE_PAYMENT=false

# === External APIs ===
NVD_API_KEY=
ABUSEIPDB_API_KEY=
# AlienVault OTX (free, commercial-OK): otx.alienvault.com
OTX_API_KEY=
# abuse.ch unified key (URLhaus + ThreatFox + MalwareBazaar): auth.abuse.ch
ABUSECH_API_KEY=
HIBP_API_KEY=
SHODAN_API_KEY=

# === Supabase (Phase 2) ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Stripe top-ups (Phase 3) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Admin dashboard (Phase 3) ===
# Visit /admin?token=<this> to access the operator dashboard.
ADMIN_TOKEN=

# === Background jobs (Phase 3) ===
# When true, long-running scans automatically run in the background and
# return a job_id immediately. Clients poll /v1/jobs/:id. Recommended on Railway.
BG_JOBS_DEFAULT=false

# === x402 Payment (Phase 2) ===
# Where customer payments are sent. Use a wallet you control.
X402_PAYEE_ADDRESS=
# Network: base | base-sepolia | ethereum
X402_NETWORK=base-sepolia
# Asset: USDC contract address (auto-resolved by network if blank)
X402_ASSET=USDC
# Facilitator URL (verifies and settles payments)
X402_FACILITATOR_URL=https://x402.org/facilitator

# === Rate Limiting ===
MAX_CONCURRENT_SCANS=5
MAX_SCANS_PER_HOUR=10

# === Scanning Engine Paths (defaults work in Docker) ===
NMAP_PATH=nmap
NUCLEI_PATH=nuclei
SSLYZE_PATH=sslyze
SEMGREP_PATH=semgrep
TRUFFLEHOG_PATH=trufflehog
TRIVY_PATH=trivy
