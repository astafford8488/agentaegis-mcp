# AgentAegis MCP Server Configuration

# Server
PORT=3000
NODE_ENV=development

# External APIs
NVD_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=
SHODAN_API_KEY=

# Supabase
SUPABASE_URL=
