{
  "name": "agentaegis-mcp",
  "version": "0.3.0",
  "description": "MCP server for cybersecurity operations — compliance, vuln scans, code security, threat intel. Pay-per-use via x402 or API key.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http-server.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@sentry/node": "^10.0.0",
    "@supabase/supabase-js": "^2.50.0",
    "@x402/core": "^2.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "uuid": "^11.1.0",
    "viem": "^2.21.0",
    "x402": "^0.5.0",
    "x402-express": "^0.5.0",
    "x402-fetch": "^1.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@x402/evm": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.15.0": ">=1.15.0"
    }
  },
  "packageManager": "pnpm@10.33.2",
  "license": "MIT"
}
