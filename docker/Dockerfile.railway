FROM node:22-slim

# Install scanning engines
RUN apt-get update && apt-get install -y \
    nmap \
    python3 \
    python3-pip \
    git \
    curl \
    wget \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python-based tools
RUN pip3 install --break-system-packages sslyze semgrep

# Bundle Semgrep rules INTO the image. The locked-down runtime container can't
# fetch rules from the registry, so --config=auto / p/default resolve to ZERO
# rules → sast_scan finds nothing. We clone the registry rules at build time
# (network available here) but must NOT point SEMGREP_CONFIG at the repo ROOT:
# its templates, jsonnet libs and test-fixture YAML are invalid as standalone
# rules, so Semgrep exits 7 ("≥1 invalid rule") and returns zero findings. Instead
# we assemble a curated ruleset from just the `security` rule dirs (command
# injection, SQLi, XSS, crypto, deserialization, SSRF, path traversal, …) — the
# high-value SAST coverage — strip non-YAML fixtures, and point SEMGREP_CONFIG
# there for offline, deterministic scans. semgrep.ts reads SEMGREP_CONFIG and
# tolerates a residual exit 7 (logs invalid rules, keeps valid findings).
RUN git clone --depth 1 https://github.com/semgrep/semgrep-rules.git /tmp/semgrep-rules \
    && mkdir -p /opt/aegis-rules \
    && n=0; for d in $(find /tmp/semgrep-rules -type d -name security); do cp -r "$d" "/opt/aegis-rules/pack-$n"; n=$((n+1)); done \
    && find /opt/aegis-rules -type f ! \( -name '*.yaml' -o -name '*.yml' \) -delete \
    && find /opt/aegis-rules -depth -type d -empty -delete \
    && rm -rf /tmp/semgrep-rules \
    && chmod -R a+rX /opt/aegis-rules \
    && echo "[build] aegis-rules YAML count:" $(find /opt/aegis-rules -name '*.y*ml' | wc -l)
ENV SEMGREP_CONFIG=/opt/aegis-rules

# Install trufflehog
RUN curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin

# Install trivy
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

# Install nuclei
RUN curl -sfL "https://github.com/projectdiscovery/nuclei/releases/latest/download/nuclei_3.3.5_linux_amd64.zip" -o /tmp/nuclei.zip \
    && unzip /tmp/nuclei.zip -d /usr/local/bin nuclei \
    && rm /tmp/nuclei.zip \
    && chmod +x /usr/local/bin/nuclei \
    && /usr/local/bin/nuclei -update-templates -silent || true

# Set up app
WORKDIR /app

# Pin pnpm via Corepack — must match `packageManager` field in package.json.
# Without pinning, `npm install -g pnpm` grabs whatever is "latest", which can
# introduce stricter lockfile/override-comparison rules and fail builds whose
# lockfile was generated with an older pnpm. The version below MUST equal the
# version that wrote pnpm-lock.yaml.
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

# Copy and install deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY . .
RUN pnpm build

# Create temp directory for scans
RUN mkdir -p /tmp/aegis-scans && chmod 777 /tmp/aegis-scans

# Cleanup
RUN rm -rf node_modules/.cache

# Drop privileges — run as a non-root user (CWE-250 hardening).
# We only need write access to /tmp/aegis-scans at runtime; /app is read-only
# during execution, so we skip the expensive chown -R /app on node_modules.
RUN groupadd -r aegis && useradd -r -g aegis -d /home/aegis -s /sbin/nologin -m aegis \
    && chown -R aegis:aegis /tmp/aegis-scans

USER aegis

EXPOSE 3000

# HOME must be set for the non-root user, or Python tools that write a settings/
# cache dir (Semgrep especially) fail silently — which made sast_scan return zero
# findings even with rules present (validation sweep).
ENV HOME=/home/aegis
ENV NODE_ENV=production

CMD ["node", "dist/http-server.js"]
