FROM node:22-slim

# Install scanning engines
RUN apt-get update && apt-get install -y \
    nmap \
    python3 \
    python3-pip \
    git \
    curl \
    wget \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python-based tools
RUN pip3 install --break-system-packages sslyze semgrep

# Bundle Semgrep rules INTO the image. The locked-down runtime container can't
# fetch rules from the registry (and the non-root user can't write Semgrep's
# cache), so --config=auto / p/default resolve to ZERO rules → sast_scan finds
# nothing (validation sweep caught this). Clone the registry rules at build time
# (network available here) and point SEMGREP_CONFIG at the local copy so scans
# are offline + deterministic. semgrep.ts reads SEMGREP_CONFIG.
RUN git clone --depth 1 https://github.com/semgrep/semgrep-rules.git /opt/semgrep-rules \
    && rm -rf /opt/semgrep-rules/.git \
    && chmod -R a+rX /opt/semgrep-rules
ENV SEMGREP_CONFIG=/opt/semgrep-rules

# Install trufflehog
RUN curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin

# Install trivy
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

# Install nuclei
RUN curl -sfL "https://github.com/projectdiscovery/nuclei/releases/latest/download/nuclei_3.3.5_linux_amd64.zip" -o /tmp/nuclei.zip \
    && unzip /tmp/nuclei.zip -d /usr/local/bin nuclei \
    && rm /tmp/nuclei.zip \
    && chmod +x /usr/local/bin/nuclei \
    && /usr/local/bin/nuclei -update-templates -silent || true

# Set up app
WORKDIR /app

# Pin pnpm via Corepack — must match `packageManager` field in package.json.
# Without pinning, `npm install -g pnpm` grabs whatever is "latest", which can
# introduce stricter lockfile/override-comparison rules and fail builds whose
# lockfile was generated with an older pnpm. The version below MUST equal the
# version that wrote pnpm-lock.yaml.
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

# Copy and install deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY . .
RUN pnpm build

# Create temp directory for scans
RUN mkdir -p /tmp/aegis-scans && chmod 777 /tmp/aegis-scans

# Cleanup
RUN rm -rf node_modules/.cache

# Drop privileges — run as a non-root user (CWE-250 hardening).
# We only need write access to /tmp/aegis-scans at runtime; /app is read-only
# during execution, so we skip the expensive chown -R /app on node_modules.
RUN groupadd -r aegis && useradd -r -g aegis -d /home/aegis -s /sbin/nologin -m aegis \
    && chown -R aegis:aegis /tmp/aegis-scans

USER aegis

EXPOSE 3000

ENV NODE_ENV=production

CMD ["node", "dist/http-server.js"]
