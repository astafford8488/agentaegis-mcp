data: {"result":{"content":[{"type":"text","text":"{\n  \"scan_id\": \"a8656157-8d05-4899-b593-50bfb095543a\",\n  \"source_type\": \"git_repo\",\n  \"source_url\": \"https://github.com/astafford8488/agentaegis-mcp\",\n  \"language\": \"auto-detected\",\n  \"findings\": [\n    {\n      \"id\": \"semgrep-dockerfile.security.missing-user.missing-user-/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/docker/Dockerfile-41\",\n      \"title\": \"missing-user\",\n      \"description\": \"By not specifying a USER, a program in the container may run as 'root'. This is a security hazard. If an attacker can control a process running as root, they may have control over the container. Ensure that the last USER in a Dockerfile is a USER other than 'root'.\",\n      \"severity\": \"high\",\n      \"cwe_id\": \"CWE-250: Execution with Unnecessary Privileges\",\n      \"affected_system\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/docker/Dockerfile\",\n      \"affected_component\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/docker/Dockerfile:41\",\n      \"evidence\": \"requires login\",\n      \"remediation\": \"USER non-root\\nCMD [\\\"pnpm\\\", \\\"start\\\"]\",\n      \"references\": [\n        \"https://owasp.org/Top10/A04_2021-Insecure_Design\"\n      ]\n    },\n    {\n      \"id\": \"semgrep-javascript.lang.security.audit.unsafe-formatstring.unsafe-formatstring-/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/queue/backgroundJobs.ts-129\",\n      \"title\": \"unsafe-formatstring\",\n      \"description\": \"Detected string concatenation with a non-literal variable in a util.format / console.log function. If an attacker injects a format specifier in the string, it will forge the log message. Try to use constant values for the format string.\",\n      \"severity\": \"low\",\n      \"cwe_id\": \"CWE-134: Use of Externally-Controlled Format String\",\n      \"affected_system\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/queue/backgroundJobs.ts\",\n      \"affected_component\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/queue/backgroundJobs.ts:129\",\n      \"evidence\": \"requires login\",\n      \"remediation\": \"Review and fix the security issue at /tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/queue/backgroundJobs.ts:129\",\n      \"references\": [\n        \"https://cwe.mitre.org/data/definitions/134.html\"\n      ]\n    },\n    {\n      \"id\": \"semgrep-problem-based-packs.insecure-transport.js-node.bypass-tls-verification.bypass-tls-verification-/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/blueTeam/emailSecurityAudit.ts-120\",\n      \"title\": \"bypass-tls-verification\",\n      \"description\": \"Checks for setting the environment variable NODE_TLS_REJECT_UNAUTHORIZED to 0, which disables TLS verification. This should only be used for debugging purposes. Setting the option rejectUnauthorized to false bypasses verification against the list of trusted CAs, which also leads to insecure transport. These options lead to vulnerability to MTM attacks, and should not be used.\",\n      \"severity\": \"medium\",\n      \"cwe_id\": \"C\",\n      \"affected_system\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/blueTeam/emailSecurityAudit.ts\",\n      \"affected_component\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/blueTeam/emailSecurityAudit.ts:120\",\n      \"evidence\": \"requires login\",\n      \"remediation\": \"Review and fix the security issue at /tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/blueTeam/emailSecurityAudit.ts:120\",\n      \"references\": [\n        \"https://nodejs.org/api/https.html#https_https_request_options_callback\",\n        \"https://stackoverflow.com/questions/20433287/node-js-request-cert-has-expired#answer-29397100\"\n      ]\n    },\n    {\n      \"id\": \"semgrep-javascript.lang.security.audit.path-traversal.path-join-resolve-traversal.path-join-resolve-traversal-/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/codeSecurity/dependencyAudit.ts-46\",\n      \"title\": \"path-join-resolve-traversal\",\n      \"description\": \"Detected possible user input going into a `path.join` or `path.resolve` function. This could possibly lead to a path traversal vulnerability,  where the attacker can access arbitrary files stored in the file system. Instead, be sure to sanitize or validate user input first.\",\n      \"severity\": \"medium\",\n      \"cwe_id\": \"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')\",\n      \"affected_system\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/codeSecurity/dependencyAudit.ts\",\n      \"affected_component\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/codeSecurity/dependencyAudit.ts:46\",\n      \"evidence\": \"requires login\",\n      \"remediation\": \"Review and fix the security issue at /tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/codeSecurity/dependencyAudit.ts:46\",\n      \"references\": [\n        \"https://owasp.org/www-community/attacks/Path_Traversal\"\n      ]\n    },\n    {\n      \"id\": \"semgrep-javascript.lang.security.audit.path-traversal.path-join-resolve-traversal.path-join-resolve-traversal-/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src/tools/codeSecurity/sastScan.ts-59\",\n      \"title\": \"path-join-resolve-traversal\",\n      \"description\": \"Detected possible user input going into a `path.join` or `path.resolve` function. This could possibly lead to a path traversal vulnerability,  where the attacker can access arbitrary files stored in the file system. Instead, be sure to sanitize or validate user input first.\",\n      \"severity\": \"medium\",\n      \"cwe_id\": \"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')\",\n      \"affected_system\": \"/tmp/aegis-0d35443a-6263-4deb-94e2-6ede6a63c43d/repo/src