# Copy to .env.red-team and fill in. NEVER commit .env.red-team.

# Production endpoint to red-team
TARGET_BASE_URL=https://agentaegis-mcp-production.up.railway.app
PORTAL_BASE_URL=https://app.agentaegis.org

# Test customer with a SMALL balance ($0.20 max so we can verify the
# concurrent-balance-debit cap without touching real customer money).
# Issue this customer + key fresh before running tests; revoke after.
RED_TEAM_API_KEY=aegis_test_only_do_not_share
RED_TEAM_CUSTOMER_ID=00000000-0000-0000-0000-000000000000

# A second test customer to verify cross-customer RLS (G1).
RED_TEAM_OTHER_CUSTOMER_ID=00000000-0000-0000-0000-000000000001

# For tests that require a logged-in portal session (E1-E3 webhook SSRF, F-series).
# Get this by:
#   1. Sign into https://app.agentaegis.org with a TEST Google account
#   2. Open DevTools → Application → Cookies → copy the sb-* cookies
#   3. Format as a single Cookie header value, e.g.:
#      PORTAL_SESSION_COOKIE="sb-access-token=...; sb-refresh-token=..."
PORTAL_SESSION_COOKIE=

# Public Supabase metadata (same as portal env, anon key is fine — public-by-design)
SUPABASE_URL=https://thtnfctijtpdoplyftaw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_rNNRSb3h8ULidsO6j4oIhw_-o3dsQ6T

# For G2 (service-role disclosure check), we deliberately DO NOT include the
# service-role key. The test verifies that even an attacker with anon-only
# access can't escalate to service-role.
